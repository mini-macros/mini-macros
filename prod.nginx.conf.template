events {
  use epoll;
  multi_accept on;
  accept_mutex on;
  worker_connections ${WORKER_CONNECTIONS};
}

http {
  include /etc/nginx/mime.types;

  access_log /var/log/nginx/access.log;
  error_log /var/log/nginx/error.log error;

  server {
    listen 80;
    root ${SITE_ROOT};

    server_name ${DOMAIN};
    keepalive_timeout 75s;

    location / {
      index ${INDEX};
    }

    location ~ /\.env {
      deny all;
      return 404;
    }
  }
}
